@using System.Globalization;
@using _37_WebApp_SQLite.Utilities;

<h2>Prodotti più recenti</h2>

@foreach (var prodotti in Model)
{
<div>
    <strong>@prodotti.Nome</strong>
</div>  
<div>
    <th>@PriceFormatter.Format(prodotti.Prezzo)</th>
</div>
<div>
    <th>@prodotti.CategoriaNome</th>
</div>
}
