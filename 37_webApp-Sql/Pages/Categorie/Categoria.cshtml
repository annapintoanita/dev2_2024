@page
@model CategoriaModel
@using _37_WebApp_SQLite.Pages.Categorie;
@using _37_WebApp_SQLite.Utilities;
@{
    ViewData["Title"] = "Categorie";
}


<h2>@ViewData["Title"]</h2>


<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome Categoria</th>
            <th>Azioni</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var categoria in Model.Categorie)
        {
            <tr>
                <td>@categoria.Id</td>
                <td>@categoria.Nome</td>
                <td>
                    
                    <a asp-page="/Categorie/EditCategoria" class="btn btn-warning" asp-route-id="@categoria.Id">Modifica</a>
                    <a asp-page="/Categorie/DeleteCategoria" class="btn btn-danger" asp-route-id="@categoria.Id">Elimina</a>
                
                </td>
            </tr>
        }
    </tbody>
</table>